# ==============================================================================
#  Coolify → your resource → Environment Variables → Developer View
#  Paste this block, fill in the real values, save, deploy.
# ==============================================================================

# ---- Libredesk admin ---------------------------------------------------------
# First-run password for the `System` account. Libredesk enforces 10-72 chars
# with an uppercase, a lowercase, a digit and a special character, and aborts
# the install if it fails. Generate one that satisfies that:
#   echo "$(openssl rand -base64 18)Aa1!"
LIBREDESK_SYSTEM_USER_PASSWORD=REPLACE-with-a-long-generated-passphrase

# ---- Resend ------------------------------------------------------------------
# Resend dashboard → API Keys. Needs sending + receiving access.
RESEND_API_KEY=re_REPLACE_ME

# Resend dashboard → Webhooks → your endpoint → signing secret.
# You only get this AFTER the first deploy, because the endpoint has to exist
# before you can register it. So: deploy once leaving this blank, create the
# webhook, paste the secret here, redeploy.
# While blank, signatures are NOT verified and anyone who finds the URL can
# inject tickets. Do not leave it that way.
RESEND_WEBHOOK_SECRET=

# ---- Inbound routing ---------------------------------------------------------
# List accepted addresses only; usernames and Maildirs are derived automatically.
# support@ -> support, sales@ -> sales. Both use the same generated IMAP password.
# Accounts work before the first email arrives. Unlisted addresses are dropped.
# Local parts: 1-64 chars, start with a letter/digit; then letters/digits/._-.
# Order matters — mail addressed to several entries lands in the FIRST match.
# Remove MAILBRIDGE_ROUTES when migrating; the two settings cannot be combined.
MAILBRIDGE_RECIPIENTS=support@example.resend.app,sales@example.resend.app

# Catch-all for unmatched mail. Leave BLANK to drop it. Your Resend domain
# receives every address at example.resend.app, so setting this turns spam to
# admin@, noreply@ and misspellings into tickets.
MAILBRIDGE_DEFAULT_MAILBOX=

# ---- Tuning ------------------------------------------------------------------
# Seconds between reconciler sweeps. The reconciler re-checks Resend for
# anything the webhook path missed; it is what stops tickets going missing.
RECONCILE_INTERVAL=300
LOG_LEVEL=INFO

# Postgres identity. Fine as-is.
POSTGRES_USER=libredesk
POSTGRES_DB=libredesk


# ==============================================================================
#  DO NOT ADD THESE — Coolify generates and manages them:
#
#    SERVICE_HEX_32_LIBREDESK          Libredesk encryption key
#    SERVICE_PASSWORD_POSTGRES         Postgres password
#    SERVICE_PASSWORD_MAILBRIDGEIMAP   shared internal IMAP password
#
#  They appear in the Environment Variables tab after the first deploy.
#  You need SERVICE_PASSWORD_MAILBRIDGEIMAP for EVERY Libredesk inbox —
#  all mailboxes share it, only the username differs.
#
#  Never regenerate SERVICE_HEX_32_LIBREDESK on a live instance: changing the
#  encryption key makes every stored secret unreadable.
# ==============================================================================
